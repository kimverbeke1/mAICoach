# VOORBEELD - hernoem NIET naar secrets.toml in je repo.
# Plak de inhoud (met echte waarden) in Streamlit Cloud:
#   App settings -> Secrets
# Lokaal: kopieer naar .streamlit/secrets.toml (die is ge-gitignored).

INTERVALS_API_KEY = "jouw_intervals_icu_api_key"
INTERVALS_ATHLETE_ID = "i123456"
OPENAI_API_KEY = "sk-jouw_openai_key"
OPENAI_MODEL = "gpt-5-mini"
USE_REAL_AI = "true"

# --- Persistente opslag (Google Cloud Storage) ---
GCS_BUCKET = "maicoach-data"

[gcp_service_account]
type = "service_account"
project_id = "jouw-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nREGEL1\nREGEL2\n-----END PRIVATE KEY-----\n"
client_email = "maicoach-storage@jouw-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
